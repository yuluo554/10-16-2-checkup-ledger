# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
# 虚拟环境：用通配覆盖 .venv / .venv-clean / venv-312 等各种命名
# （只写死 .venv/ 会漏掉临时验证用的 .venv-clean/，门禁扫描面会扫进第三方包）
.venv*/
venv*/
env/
.eggs/

# Environment / secrets
.env
.env.*
*.key

# Local data (健康数据极敏感：真实报告与台账永不入 git)
*.db
*.sqlite
*.sqlite3
_reports/
real_reports/
private/
_private/
*.pdf
!data/samples/**/*.pdf
*.jpg
*.jpeg
*.png
!data/samples/**/*.jpg
!data/samples/**/*.png

# OCR model cache
models/
.onnx/
~/.RapidOCR
.cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs / temp
*.log
tmp/
