{
  "schema_version": 1,
  "coverage_note": "采样覆盖，非穷举。逐条用例即下表；新增形态须同时更新 plan/04 的覆盖度门槛表。",
  "suites": [
    {
      "name": "判定契约",
      "purpose": "四态语义与来源标注的基本正确性",
      "cases": [
        {"case_id": "contract-high", "canonical_name": "ALT", "value": 47.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "high", "expected_source": "builtin_default",
         "why": "超上限 → H"},
        {"case_id": "contract-low", "canonical_name": "ALT", "value": 5.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "low", "expected_source": "builtin_default",
         "why": "低于下限 → L"},
        {"case_id": "contract-normal", "canonical_name": "ALT", "value": 25.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "区间内 → 正常"},
        {"case_id": "contract-no-range", "canonical_name": "XXX", "value": 25.0, "unit": "U/L",
         "printed_range": null, "default_range": null,
         "expected_flag": "not_assessed", "expected_source": "none",
         "why": "无区间 → 拒判（绝不是 normal）"},
        {"case_id": "contract-upper-only", "canonical_name": "TC", "value": 6.0, "unit": "mmol/L",
         "printed_range": null, "default_range": {"low": null, "high": 5.2},
         "expected_flag": "high", "expected_source": "builtin_default",
         "why": "单侧上限：只给上限时下限不设限"},
        {"case_id": "contract-upper-only-normal", "canonical_name": "TC", "value": 1.0, "unit": "mmol/L",
         "printed_range": null, "default_range": {"low": null, "high": 5.2},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "单侧上限：远低于上限仍为正常"}
      ]
    },
    {
      "name": "三级优先",
      "purpose": "报告自印 > 内置默认 > 拒判，最优先语义必须真的生效",
      "cases": [
        {"case_id": "priority-printed-wins-high", "canonical_name": "ALT", "value": 42.0, "unit": "U/L",
         "printed_range": {"low": 9, "high": 40}, "default_range": {"low": 9, "high": 50},
         "expected_flag": "high", "expected_source": "report_printed",
         "why": "自印与默认结论相反时，必须用自印 → H"},
        {"case_id": "priority-printed-wins-normal", "canonical_name": "ALT", "value": 45.0, "unit": "U/L",
         "printed_range": {"low": 9, "high": 50}, "default_range": {"low": 9, "high": 40},
         "expected_flag": "normal", "expected_source": "report_printed",
         "why": "自印放宽时不得回落到更严的默认值"},
        {"case_id": "priority-fallback-default", "canonical_name": "ALT", "value": 47.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "high", "expected_source": "builtin_default",
         "why": "无自印 → 用默认"},
        {"case_id": "priority-no-range", "canonical_name": "ALT", "value": 47.0, "unit": "U/L",
         "printed_range": null, "default_range": null,
         "expected_flag": "not_assessed", "expected_source": "none",
         "why": "自印与默认都无 → 拒判"},
        {"case_id": "priority-partial-printed", "canonical_name": "TC", "value": 6.0, "unit": "mmol/L",
         "printed_range": {"low": null, "high": 5.2}, "default_range": {"low": null, "high": 4.0},
         "expected_flag": "high", "expected_source": "report_printed",
         "why": "自印只印上限也优先于默认（报告上印的才是有效区间）"}
      ]
    },
    {
      "name": "边界语义",
      "purpose": "闭/开区间的边界归属，以及「差一点」不命中",
      "cases": [
        {"case_id": "boundary-exact-closed-high", "canonical_name": "ALT", "value": 40.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40, "bounds": "closed"},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "闭区间：恰等于上限 → 正常"},
        {"case_id": "boundary-exact-open-high", "canonical_name": "ALT", "value": 40.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40, "bounds": "open"},
         "expected_flag": "high", "expected_source": "builtin_default",
         "why": "开区间：恰等于上限 → 越界"},
        {"case_id": "boundary-exact-closed-low", "canonical_name": "ALT", "value": 9.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40, "bounds": "closed"},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "闭区间：恰等于下限 → 正常"},
        {"case_id": "boundary-exact-open-low", "canonical_name": "ALT", "value": 9.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40, "bounds": "open"},
         "expected_flag": "low", "expected_source": "builtin_default",
         "why": "开区间：恰等于下限 → 越界"},
        {"case_id": "boundary-near-miss-high", "canonical_name": "ALT", "value": 39.99, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "差一点不到上限 → 不命中 H"},
        {"case_id": "boundary-near-miss-low", "canonical_name": "ALT", "value": 9.01, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "差一点高于下限 → 不命中 L"},
        {"case_id": "boundary-just-over", "canonical_name": "ALT", "value": 40.01, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "high", "expected_source": "builtin_default",
         "why": "刚过上限 → 命中 H"}
      ]
    },
    {
      "name": "反向样例",
      "purpose": "「不该命中」的形态：只测「该命中」，适用域与拒判语义写错永远不会红",
      "cases": [
        {"case_id": "negative-no-range-not-normal", "canonical_name": "ALT", "value": 25.0, "unit": "U/L",
         "printed_range": null, "default_range": null,
         "expected_flag": "not_assessed", "expected_source": "none",
         "why": "反向：区间缺失时**不得**判为 normal（拒判不是正常）"},
        {"case_id": "negative-pending-not-usable", "canonical_name": "ALT", "value": 47.0, "unit": "U/L",
         "printed_range": null, "default_range": null,
         "expected_flag": "not_assessed", "expected_source": "none",
         "why": "反向：pending 默认值不进判定路径 → 无可用区间 → 拒判"},
        {"case_id": "negative-in-range-not-flagged-high", "canonical_name": "ALT", "value": 25.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "反向：区间内**不得**误标 H（防「一律标异常」）"},
        {"case_id": "negative-in-range-not-flagged-low", "canonical_name": "ALT", "value": 25.0, "unit": "U/L",
         "printed_range": null, "default_range": {"low": 9, "high": 40},
         "expected_flag": "normal", "expected_source": "builtin_default",
         "why": "反向：区间内**不得**误标 L（防「一律标异常」）"}
      ]
    }
  ]
}
